# ==========================================
# Application Environment
# ==========================================
# Mode: development | production | test
APP_ENV=development
PORT=5000

# Security Secret (JWT token signing - minimum 32 characters)
JWT_SECRET=replace-with-at-least-32-random-characters

# Room Wi-Fi Credential Encryption Secret (AES-256-GCM 256-bit key)
# Required for room Wi-Fi hotspot password encryption/decryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# STRICT SECURITY: Must be a dedicated 64-hex character or 44-base64 character key.
# NEVER derive from or reuse JWT_SECRET or APP_KEY.
WIFI_CREDENTIAL_ENCRYPTION_KEY=replace-with-64-character-hex-aes-256-key

# ==========================================
# SQLite Database Configuration
# ==========================================
# Local Development default: database_dev.sqlite
# Production Host default: database_prod.sqlite
DB_DATABASE=database_dev.sqlite

# Optional: Explicit full path to database file (e.g. /var/data/bwork.sqlite or D:\POS_Data\database_prod.sqlite)
# DB_PATH=

# Optional network DB parameters (for standard environment variable compatibility)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=pos_user
# DB_PASSWORD=
