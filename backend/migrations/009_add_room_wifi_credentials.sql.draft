-- 1. Add Room Wi-Fi Hotspot Username
-- Plaintext identifier matching MikroTik Hotspot user profile (e.g. 'room_101', 'conf_a')
-- Nullable: rooms without dedicated Hotspot credentials remain NULL
ALTER TABLE rooms ADD COLUMN wifi_username TEXT;

-- 2. Add Room Wi-Fi Hotspot Encrypted Password
-- Format: v1:<iv_hex>:<tag_hex>:<ciphertext_hex>
-- Encrypted using AES-256-GCM with room-specific AAD ('room:<roomId>')
-- STRICT POLICY: Plaintext passwords MUST NEVER be stored in this column
-- Nullable: rooms without credentials remain NULL
ALTER TABLE rooms ADD COLUMN wifi_password_enc TEXT;

